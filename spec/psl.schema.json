{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://psl.dev/spec/psl.schema.json",
    "title":  "Program Specification Language AST",
    "type":  "object",
    "required":  [
                     "language_version",
                     "metadata",
                     "sessions"
                 ],
    "additionalProperties":  false,
    "properties":  {
                       "language_version":  {
                                                "const":  "0.1"
                                            },
                       "metadata":  {
                                        "$ref":  "#/$defs/metadata"
                                    },
                       "calendar":  {
                                        "$ref":  "#/$defs/calendar"
                                    },
                       "sessions":  {
                                        "type":  "array",
                                        "minItems":  1,
                                        "items":  {
                                                      "$ref":  "#/$defs/session"
                                                  }
                                    }
                   },
    "$defs":  {
                  "metadata":  {
                                   "type":  "object",
                                   "required":  [
                                                    "id",
                                                    "name"
                                                ],
                                   "additionalProperties":  false,
                                   "properties":  {
                                                      "id":  {
                                                                 "type":  "string",
                                                                 "minLength":  1
                                                             },
                                                      "name":  {
                                                                   "type":  "string",
                                                                   "minLength":  1
                                                               },
                                                      "description":  {
                                                                          "type":  "string"
                                                                      },
                                                      "author":  {
                                                                     "type":  "string"
                                                                 }
                                                  }
                               },
                  "calendar":  {
                                   "type":  "object",
                                   "required":  [
                                                    "start_date"
                                                ],
                                   "additionalProperties":  false,
                                   "properties":  {
                                                      "start_date":  {
                                                                         "$ref":  "#/$defs/isoDate"
                                                                     },
                                                      "end_date":  {
                                                                       "$ref":  "#/$defs/isoDate"
                                                                   },
                                                      "timezone":  {
                                                                       "type":  "string",
                                                                       "minLength":  1
                                                                   }
                                                  }
                               },
                  "isoDate":  {
                                  "type":  "string",
                                  "pattern":  "^\\d{4}-\\d{2}-\\d{2}$"
                              },
                  "weekday":  {
                                  "type":  "string",
                                  "enum":  [
                                               "MON",
                                               "TUE",
                                               "WED",
                                               "THU",
                                               "FRI",
                                               "SAT",
                                               "SUN"
                                           ]
                              },
                  "sessionSchedule":  {
                                          "oneOf":  [
                                                        {
                                                            "type":  "object",
                                                            "required":  [
                                                                             "type",
                                                                             "every"
                                                                         ],
                                                            "additionalProperties":  false,
                                                            "properties":  {
                                                                               "type":  {
                                                                                            "const":  "interval_days"
                                                                                        },
                                                                               "every":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  1
                                                                                         },
                                                                               "start_offset_days":  {
                                                                                                         "type":  "integer",
                                                                                                         "minimum":  0
                                                                                                     }
                                                                           }
                                                        },
                                                        {
                                                            "type":  "object",
                                                            "required":  [
                                                                             "type",
                                                                             "days"
                                                                         ],
                                                            "additionalProperties":  false,
                                                            "properties":  {
                                                                               "type":  {
                                                                                            "const":  "weekdays"
                                                                                        },
                                                                               "days":  {
                                                                                            "type":  "array",
                                                                                            "minItems":  1,
                                                                                            "items":  {
                                                                                                          "$ref":  "#/$defs/weekday"
                                                                                                      }
                                                                                        },
                                                                               "start_offset_days":  {
                                                                                                         "type":  "integer",
                                                                                                         "minimum":  0
                                                                                                     }
                                                                           }
                                                        }
                                                    ]
                                      },
                  "session":  {
                                  "type":  "object",
                                  "required":  [
                                                   "id",
                                                   "name",
                                                   "exercises"
                                               ],
                                  "additionalProperties":  false,
                                  "properties":  {
                                                     "id":  {
                                                                "type":  "string",
                                                                "minLength":  1
                                                            },
                                                     "name":  {
                                                                  "type":  "string",
                                                                  "minLength":  1
                                                              },
                                                     "day":  {
                                                                 "type":  "integer",
                                                                 "minimum":  1
                                                             },
                                                     "schedule":  {
                                                                      "$ref":  "#/$defs/sessionSchedule"
                                                                  },
                                                     "exercises":  {
                                                                       "type":  "array",
                                                                       "minItems":  1,
                                                                       "items":  {
                                                                                     "$ref":  "#/$defs/exercise"
                                                                                 }
                                                                   }
                                                 },
                                  "oneOf":  [
                                                {
                                                    "required":  [
                                                                     "day"
                                                                 ],
                                                    "not":  {
                                                                "required":  [
                                                                                 "schedule"
                                                                             ]
                                                            }
                                                },
                                                {
                                                    "required":  [
                                                                     "schedule"
                                                                 ]
                                                }
                                            ]
                              },
                  "exercise":  {
                                   "type":  "object",
                                   "required":  [
                                                    "exercise",
                                                    "sets"
                                                ],
                                   "additionalProperties":  false,
                                   "properties":  {
                                                      "exercise":  {
                                                                       "type":  "string",
                                                                       "minLength":  1
                                                                   },
                                                      "sets":  {
                                                                   "type":  "array",
                                                                   "minItems":  1,
                                                                   "items":  {
                                                                                 "$ref":  "#/$defs/set"
                                                                             }
                                                               },
                                                      "rest_seconds":  {
                                                                           "type":  "integer",
                                                                           "minimum":  0
                                                                       }
                                                  }
                               },
                  "set":  {
                              "oneOf":  [
                                            {
                                                "type":  "string",
                                                "minLength":  1
                                            },
                                            {
                                                "type":  "object",
                                                "required":  [
                                                                 "count",
                                                                 "reps"
                                                             ],
                                                "additionalProperties":  false,
                                                "properties":  {
                                                                   "count":  {
                                                                                 "type":  "integer",
                                                                                 "minimum":  1
                                                                             },
                                                                   "reps":  {
                                                                                "oneOf":  [
                                                                                              {
                                                                                                  "type":  "integer",
                                                                                                  "minimum":  1
                                                                                              },
                                                                                              {
                                                                                                  "type":  "object",
                                                                                                  "required":  [
                                                                                                                   "min",
                                                                                                                   "max"
                                                                                                               ],
                                                                                                  "additionalProperties":  false,
                                                                                                  "properties":  {
                                                                                                                     "min":  {
                                                                                                                                 "type":  "integer",
                                                                                                                                 "minimum":  1
                                                                                                                             },
                                                                                                                     "max":  {
                                                                                                                                 "type":  "integer",
                                                                                                                                 "minimum":  1
                                                                                                                             }
                                                                                                                 }
                                                                                              }
                                                                                          ]
                                                                            },
                                                                   "intensity":  {
                                                                                     "$ref":  "#/$defs/intensity"
                                                                                 },
                                                                   "note":  {
                                                                                "type":  "string"
                                                                            }
                                                               }
                                            }
                                        ]
                          },
                  "intensity":  {
                                    "oneOf":  [
                                                  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "type",
                                                                       "value"
                                                                   ],
                                                      "additionalProperties":  false,
                                                      "properties":  {
                                                                         "type":  {
                                                                                      "const":  "percent_1rm"
                                                                                  },
                                                                         "value":  {
                                                                                       "type":  "number",
                                                                                       "exclusiveMinimum":  0,
                                                                                       "maximum":  150
                                                                                   }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "type",
                                                                       "value"
                                                                   ],
                                                      "additionalProperties":  false,
                                                      "properties":  {
                                                                         "type":  {
                                                                                      "const":  "rpe"
                                                                                  },
                                                                         "value":  {
                                                                                       "type":  "number",
                                                                                       "minimum":  1,
                                                                                       "maximum":  10
                                                                                   }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "type",
                                                                       "value"
                                                                   ],
                                                      "additionalProperties":  false,
                                                      "properties":  {
                                                                         "type":  {
                                                                                      "const":  "rir"
                                                                                  },
                                                                         "value":  {
                                                                                       "type":  "number",
                                                                                       "minimum":  0,
                                                                                       "maximum":  6
                                                                                   }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "type",
                                                                       "value",
                                                                       "unit"
                                                                   ],
                                                      "additionalProperties":  false,
                                                      "properties":  {
                                                                         "type":  {
                                                                                      "const":  "load"
                                                                                  },
                                                                         "value":  {
                                                                                       "type":  "number",
                                                                                       "exclusiveMinimum":  0
                                                                                   },
                                                                         "unit":  {
                                                                                      "type":  "string",
                                                                                      "enum":  [
                                                                                                   "kg",
                                                                                                   "lb"
                                                                                               ]
                                                                                  }
                                                                     }
                                                  }
                                              ]
                                }
              }
}

