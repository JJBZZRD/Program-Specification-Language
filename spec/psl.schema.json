{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psl.dev/spec/psl.schema.json",
  "title": "Program Specification Language Source Schema",
  "description": "PSL v0.2 source schema (backward-compatible with v0.1).",
  "type": "object",
  "required": ["language_version", "metadata"],
  "additionalProperties": false,
  "properties": {
    "language_version": { "type": "string", "enum": ["0.1", "0.2"] },
    "metadata": { "$ref": "#/$defs/metadata" },
    "calendar": { "$ref": "#/$defs/calendar" },
    "units": { "$ref": "#/$defs/loadUnit" },
    "rounding": { "$ref": "#/$defs/roundingPolicy" },
    "exercise_aliases": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/session" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "allOf": [
    {
      "oneOf": [
        { "required": ["sessions"], "not": { "required": ["blocks"] } },
        { "required": ["blocks"], "not": { "required": ["sessions"] } }
      ]
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" }
      }
    },
    "calendar": {
      "type": "object",
      "required": ["start_date"],
      "additionalProperties": false,
      "properties": {
        "start_date": { "$ref": "#/$defs/isoDate" },
        "end_date": { "$ref": "#/$defs/isoDate" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weekday": { "type": "string", "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] },
    "loadUnit": { "type": "string", "enum": ["kg", "lb"] },
    "duration": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
    "roundingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round_to": { "type": "number", "exclusiveMinimum": 0 },
        "mode": { "type": "string", "enum": ["nearest", "down", "up"] },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "barbell": { "type": "number", "exclusiveMinimum": 0 },
            "dumbbell": { "type": "number", "exclusiveMinimum": 0 },
            "machine": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "schedule": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type", "every"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "interval_days" },
            "every": { "type": "integer", "minimum": 1 },
            "start_offset_days": { "type": "integer", "minimum": 0 },
            "end_offset_days": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "days"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "weekdays" },
            "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weekday" } },
            "start_offset_days": { "type": "integer", "minimum": 0 },
            "end_offset_days": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "repTarget": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "intensity": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["percent_1rm", "rpe", "rir", "load", "load_range", "percent_of_set", "load_delta_from_set"]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "progression": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["weekly_increment", "increment", "auto_adjust"] },
            "scope": { "type": "string", "enum": ["set", "exercise", "session"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_rpe": { "type": "number" },
        "min_rir": { "type": "number" },
        "max_sets": { "type": "integer", "minimum": 1 },
        "max_total_reps": { "type": "integer", "minimum": 1 },
        "stop_on_failure": { "type": "boolean" },
        "velocity_loss_cap": { "type": "number" }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_sets": { "type": "integer", "minimum": 1 },
        "until": { "type": "object" }
      }
    },
    "tempo": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eccentric": { "type": "string" },
            "pause_bottom": { "type": "string" },
            "concentric": { "type": "string" },
            "pause_top": { "type": "string" }
          }
        }
      ]
    },
    "warmup": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["percent_ramp", "steps"] }
      },
      "additionalProperties": true
    },
    "set": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["count"],
          "additionalProperties": true,
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "reps": { "$ref": "#/$defs/repTarget" },
            "work_type": { "type": "string", "enum": ["reps", "time"] },
            "time_mode": { "type": "string", "enum": ["amrap", "emom", "for_time", "density"] },
            "duration_seconds": { "$ref": "#/$defs/duration" },
            "interval_seconds": { "$ref": "#/$defs/duration" },
            "target_total_reps": { "type": "integer", "minimum": 1 },
            "intensity": { "$ref": "#/$defs/intensity" },
            "role": { "type": "string", "minLength": 1 },
            "rest_seconds": { "$ref": "#/$defs/duration" },
            "rest": { "$ref": "#/$defs/duration" },
            "rest_before_seconds": { "$ref": "#/$defs/duration" },
            "rest_before": { "$ref": "#/$defs/duration" },
            "rest_after_seconds": { "$ref": "#/$defs/duration" },
            "rest_after": { "$ref": "#/$defs/duration" },
            "constraints": { "$ref": "#/$defs/constraints" },
            "repeat": { "$ref": "#/$defs/repeat" },
            "progression": { "$ref": "#/$defs/progression" },
            "tempo": { "$ref": "#/$defs/tempo" },
            "pause_seconds": { "$ref": "#/$defs/duration" },
            "eccentric_seconds": { "$ref": "#/$defs/duration" },
            "note": { "type": "string" },
            "shorthand": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "exercise": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["exercise", "sets"],
          "additionalProperties": true,
          "properties": {
            "exercise": { "type": "string", "minLength": 1 },
            "exercise_id": { "type": "string", "minLength": 1 },
            "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "family": { "type": "string", "minLength": 1 },
            "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "modifiers": { "type": "object", "additionalProperties": { "type": "string" } },
            "substitutions": { "type": "array", "items": { "type": "object" } },
            "constraints": { "$ref": "#/$defs/constraints" },
            "warmup": { "$ref": "#/$defs/warmup" },
            "group_id": { "type": "string", "minLength": 1 },
            "sets": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/set" } }
              ]
            },
            "rest_seconds": { "$ref": "#/$defs/duration" },
            "rest": { "$ref": "#/$defs/duration" },
            "rest_before_seconds": { "$ref": "#/$defs/duration" },
            "rest_before": { "$ref": "#/$defs/duration" },
            "rest_after_seconds": { "$ref": "#/$defs/duration" },
            "rest_after": { "$ref": "#/$defs/duration" },
            "tempo": { "$ref": "#/$defs/tempo" },
            "pause_seconds": { "$ref": "#/$defs/duration" },
            "eccentric_seconds": { "$ref": "#/$defs/duration" },
            "units": { "$ref": "#/$defs/loadUnit" },
            "rounding": { "$ref": "#/$defs/roundingPolicy" }
          }
        }
      ]
    },
    "sessionGroup": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["superset", "circuit", "giant_set"] },
        "exercise_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deload": { "type": "boolean" },
        "volume_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "intensity_cap": { "type": "object", "additionalProperties": true },
        "exercise_swap_map": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "name", "exercises"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "day": { "type": "integer", "minimum": 1 },
        "schedule": { "$ref": "#/$defs/schedule" },
        "slot": {
          "oneOf": [{ "type": "string", "enum": ["AM", "PM", "EVE"] }, { "type": "integer", "minimum": 1 }]
        },
        "rest_default_seconds": { "$ref": "#/$defs/duration" },
        "rest_default": { "$ref": "#/$defs/duration" },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/sessionGroup" } },
        "constraints": { "$ref": "#/$defs/constraints" },
        "modifiers": { "$ref": "#/$defs/modifiers" },
        "deload": { "type": "boolean" },
        "volume_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "intensity_cap": { "type": "object", "additionalProperties": true },
        "exercise_swap_map": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "exercises": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exercise" } }
          ]
        }
      }
    },
    "blockDuration": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["weeks", "days"] },
            "value": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "required": ["id", "duration"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "duration": { "$ref": "#/$defs/blockDuration" },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
        "modifiers": { "$ref": "#/$defs/modifiers" },
        "deload": { "type": "boolean" },
        "volume_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "intensity_cap": { "type": "object", "additionalProperties": true },
        "exercise_swap_map": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
