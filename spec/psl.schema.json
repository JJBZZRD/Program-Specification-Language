{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psl.dev/spec/psl.schema.json",
  "title": "Program Specification Language AST",
  "type": "object",
  "required": ["language_version", "metadata", "sessions"],
  "additionalProperties": false,
  "properties": {
    "language_version": {
      "const": "0.1"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "name", "day", "exercises"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "day": { "type": "integer", "minimum": 1 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["exercise", "sets"],
      "additionalProperties": false,
      "properties": {
        "exercise": { "type": "string", "minLength": 1 },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/set" }
        },
        "rest_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "set": {
      "type": "object",
      "required": ["count", "reps"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "reps": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            {
              "type": "object",
              "required": ["min", "max"],
              "additionalProperties": false,
              "properties": {
                "min": { "type": "integer", "minimum": 1 },
                "max": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "intensity": { "$ref": "#/$defs/intensity" },
        "note": { "type": "string" }
      }
    },
    "intensity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "percent_1rm" },
            "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 150 }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rpe" },
            "value": { "type": "number", "minimum": 1, "maximum": 10 }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rir" },
            "value": { "type": "number", "minimum": 0, "maximum": 6 }
          }
        }
      ]
    }
  }
}
